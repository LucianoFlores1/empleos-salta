{
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/home.js"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap.js"
    },
    {
      "source": "/api/job",
      "destination": "/api/job.js"
    },
    {
      "source": "/job/(.*)",
      "destination": "/api/job?id=$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
